{
  "name": "@alptech/openwolf",
  "version": "1.1.1",
  "description": "One project memory across Claude Code, Codex and OpenCode. Token usage measured, not estimated. Zero API calls.",
  "type": "module",
  "bin": {
    "openwolf": "dist/bin/openwolf.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prebuild": "node -e \"const fs=require('fs');if(fs.existsSync('dist'))fs.rmSync('dist',{recursive:true})\"",
    "build": "tsc && pnpm build:hooks && pnpm build:dashboard",
    "build:hooks": "tsc -p tsconfig.hooks.json",
    "build:dashboard": "cd src/dashboard/app && npx vite build --outDir ../../../dist/dashboard",
    "dev": "tsc --watch",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "prepublishOnly": "pnpm build",
    "pretest": "pnpm build",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^4.0.0",
    "commander": "^12.0.0",
    "express": "^5.2.1",
    "node-cron": "^4.2.1",
    "open": "^10.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.7",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitepress": "^1.6.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "AGPL-3.0-only",
  "author": "Cytostack Pvt Ltd (original) / alptech (fork)",
  "repository": {
    "type": "git",
    "url": "https://github.com/nottyjay/openwolf.git"
  },
  "homepage": "https://github.com/nottyjay/openwolf",
  "bugs": {
    "url": "https://github.com/nottyjay/openwolf/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "opencode",
    "agent-memory",
    "context-engineering",
    "observability",
    "context",
    "token",
    "openwolf",
    "developer-tools",
    "ai"
  ],
  "files": [
    "dist/",
    "src/templates/",
    "LICENSE",
    "README.md",
    "README.zh-CN.md",
    "README.ja.md",
    "README.ru.md"
  ]
}
